# .env.dev.example — template for the DEV tier's .env.dev (dev.norcal.pro).
#
# Copy to .env.dev and fill in:  cp .env.dev.example .env.dev
# run-dev.sh sources it (set -a; . .env.dev; set +a). .env.dev is gitignored.
#
# Ports come from this project's block in PORTS.md:
#   prod 8099 · beta/test 18099 · dev backend 19090 · dev vite 19099 · containers 3300

# --- Discord: NO BOT ON DEV (hard requirement) -------------------------------
# Air rebuilds on every Go edit; each restart would re-open the gateway and
# re-register commands (Discord rate-limits this), and would fight prod's bot —
# one gateway connection per token. run-dev.sh UNSETS these regardless, so dev
# can never inherit a token from the launching shell. Leave them blank.
# Discord OAuth login is separate and safe; set the client pair to test it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Containers OFF on dev ----------------------------------------------------
# Dev is for code/UI iteration; don't contend with prod's podman daemon.
CONTAINERS_ENABLED=false

# --- Dev superuser ------------------------------------------------------------
# Seeded on start into the ephemeral dev pb_data. Dev-only throwaway values —
# never reuse prod's. (The -tags dev seeder also creates admin@dev.com.)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# --- Frontend build-time var --------------------------------------------------
# The dev PocketBase port. api-base.ts only uses it for localhost/LAN access;
# through dev.norcal.pro the API is proxied same-origin.
PUBLIC_PB_PORT=19090

# --- Overlay tokens -----------------------------------------------------------
# Stable secret so dev-minted overlay tokens survive an Air restart.
OVERLAY_TOKEN_SECRET=
