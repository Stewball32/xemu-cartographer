  "meta": {
    "description": "Exact in-game armor/player color palettes for Halo: Combat Evolved (Xbox) and Halo 2 (Xbox). Keyed by game then color index; each entry is {name, hex, rgb}. RGB is 0-255, red-green-blue order.",
    "ce": {
      "count": 18,
      "indexOrder": "c20 palette order == blam.sav profile color enum (u32 @ 0x18)",
      "source": "c20.reclaimers.net hard-coded multiplayer armor colors (armor color values by MosesOfEgypt; testing by Lavadeeto). https://c20.reclaimers.net/h1/engine/hard-coded-data/",
      "note": "Diffuse tint values as authored; in-game appearance is further affected by cubemaps/specular. 'mccName' fields are the alternate names MCC used at launch."
    },
    "h2": {
      "count": 18,
      "indexOrder": "e_player_color enum == profile appearance bytes 0x118 (armor primary), 0x119 (armor secondary), 0x11A (emblem primary), 0x11B (emblem secondary). Emblem colors use this SAME 18-color palette.",
      "source": "Extracted from Halo 2 (Xbox) mainmenu.map globals player-color table, stored as float32 RGB (value*255). Confirmed byte-identical in shared.map. Build 02.09.27.09809.",
      "note": "Values were authored as 8-bit RGB and stored as N/255 floats; listed rgb is round(float*255). This is the diffuse player tint applied to armor and emblems."
    },
    "generatedFrom": "halo-offset-mapper / xemu-cartographer toolchain; H2 values re-extracted from local game files at build time."
  },
