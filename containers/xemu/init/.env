# Paths
TOML_PATH=/config/.local/share/xemu/xemu
DEFAULT_TOML=/shared/toml/xemu.toml
HDD_DIR=/shared/hdds

# Optional — defaults to default.qcow2 if not set
DEFAULT_HDD_NAME=_default.qcow2

# Optional — pins the host interface xemu's pcap backend binds for System Link.
# Unset: 02-patch-toml.sh autodetects the first carrier-up physical NIC, skipping
# virtual / bridge / bond / wireless / VPN interfaces and deprioritising onboard
# eno*. Set it when the host has several physical NICs and the Xboxes are on a
# specific one — autodetect cannot tell which, and the wrong NIC presents as
# "System Link connects but Halo is laggy" rather than an outright failure.
# The value is applied on EVERY container start and corrects a stale netif
# already in the instance's xemu.toml.
#
# NETIF=enp191s0
