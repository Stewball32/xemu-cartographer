package handlers

// Template for adding a new WebSocket message handler.
// Copy this file, rename it to your message type (e.g., chat.go), and
// add an init() function to self-register — no other files need editing.
//
// When a client sends {"type":"example","payload":{...}}, the Hub
// dispatches it to the handler registered for "example".

import (
	"encoding/json"

	"github.com/xemu-cartographer/xemu-cartographer/internal/authz"
)

func init() {
	register("example", handleExample)
}

func handleExample(e *Event) {
	// Authorization — one authz.Can call at the top, decided against
	// e.Authz (the process-wide adapter) with e.Principal (the sending
	// connection). A nil adapter denies everything; pick the action and
	// resource from the rule table in internal/authz:
	//
	//   if !authz.Can(e.Authz, e.Principal, authz.ActionRoomJoin, authz.RoomRes(room)) {
	//       e.SendError("forbidden", "not allowed")
	//       return
	//   }
	//
	// Kinds that may send this message type at all are decided before the
	// handler runs (authz.WSSendAllowed) — a spectator never reaches a
	// control handler, so don't re-check the kind here. e.UserID is set for
	// pb_user principals only; machine / spectator / device keys and the
	// console door have none.

	// Broadcast to all connected clients:
	e.Broadcast(e.Payload)

	// Send to a specific room:
	// e.SendToRoom("general", e.Payload)

	// Send to a specific user (all their connections):
	// e.SendToUser(e.UserID, e.Payload)

	// Join/leave rooms (for the client that sent this message):
	// e.JoinRoom("general")
	// e.LeaveRoom("general")

	// Send an error back to the sender:
	// e.SendError("bad_request", "missing required field")

	// Build a typed response:
	// resp, _ := json.Marshal(map[string]string{"echo": "hello"})
	// e.Broadcast(resp)

	// Cross-system actions — call through e.Services:
	//
	// Discord: send a notification to a channel
	//   if e.Services.Discord != nil {
	//       e.Services.Discord.SendNotification(channelID, "Hello from WS!")
	//   }
	//
	// PocketBase: look up a user by Discord ID
	//   if e.Services.PB != nil {
	//       user, err := e.Services.PB.FindUserByDiscordID("123456")
	//   }
	//
	// Or use resolvers from any package:
	//   import pbresolvers "github.com/xemu-cartographer/xemu-cartographer/internal/pocketbase/resolvers"
	//   user, err := pbresolvers.FindUserByDiscordID(e.App, discordID)

	_ = json.Marshal // silence unused import
	_ = authz.Can    // silence unused import
}
