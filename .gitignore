# Go
bin/
tmp/
tmp-dev/
vendor/
/server
/server.exe

# Dev tier (run-dev.sh) runtime artifacts
dev.log

# Task
.task/


# PocketBase
pb_data/
pb_public/

# Containers — dev-only PB seed snapshot, plus legacy JSON state file
containers/dev-seed.json
containers/state.json

# Porting reference: legacy code kept for cross-checking offsets / patterns
# when reimplementing in this repo. Local-only by default — re-verify any
# artefact before copying into the live tree.
atlas/

# WIP roadmap scratch — per-stage implementation notes, kept locally while
# the stage is in flight and deleted once the work lands.
ROADMAP-*.md

# Node / SvelteKit
sveltekit/node_modules/
sveltekit/.svelte-kit/

# Game-derived HUD icon cache (visualizer minimap markers). Decoded from the
# user's own legally-owned Halo game files by scripts/game-icons/extract_icons.py
# — game art, never committed (same legal stance as the map-preview PNGs). The
# extractor + the frontend fallback are the committed product; regenerate locally.
sveltekit/static/game-icons/

# Game-derived level-geometry cache (3D visualizer structure-BSP meshes).
# Decoded from the user's own legally-owned Halo .map files by
# scripts/game-geometry/extract_bsp.py — game geometry, never committed (same
# legal stance as the icons / map-preview PNGs). The extractor + the frontend
# degrade-to-bounds-box fallback are the committed product; regenerate locally.
sveltekit/static/game-geometry/

# Environment
.env
.env.dev
.env.beta
!.env.example
!.env.dev.example

# Local dev seed overrides — seed.local.json etc. are personal/local; only
# the committed template (seed.example.json) is tracked.
/seed.*.json
!/seed.example.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Claude Code (local-only state + agent worktrees)
/.claude/

# Playwright MCP scratch — per-call page snapshots, console logs, and
# screenshots saved by the @playwright/mcp server during browser smoke
# passes. Ephemeral; useful while a stage is in flight, no value committed.
.playwright-mcp/

# Loose dev/verification screenshots dropped in the repo root during browser
# smoke passes (bsp-editor-*.png, viz2d-*.png, studio-*.png, etc.). Root-anchored
# so only top-level PNGs are ignored — committed art under sveltekit/static, docs,
# etc. is unaffected. Ephemeral; regenerate locally, never committed.
/*.png

# Stray dev-server logs
dev-server.log
/inputpoc

# migrate:squash archives the granular migrations here so migrate:verify can
# rebuild the "before" side to compare against (see docs/MIGRATIONS.md).
.migrate-archive/

# ISO ingest drop-zone (tier-root inbox). Contents are large disc images
# staged for ingest into the managed library; never committed. Keep the dir.
/inbox/*
!/inbox/.gitkeep

# Python bytecode cache
__pycache__/
*.pyc
