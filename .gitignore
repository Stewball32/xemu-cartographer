# Porting reference: legacy code kept for cross-checking offsets / patterns
# when reimplementing in this repo. Local-only by default — re-verify any
# artefact before copying into the live tree.
atlas/

# WIP roadmap scratch — per-stage implementation notes, kept locally while
# the stage is in flight and deleted once the work lands.
ROADMAP-*.md

# Node / SvelteKit
sveltekit/node_modules/
sveltekit/.svelte-kit/

# Environment
.env
!.env.example
!sveltekit/.env.example

# Local dev seed overrides — seed.local.json etc. are personal/local; only
# the committed template (seed.example.json) is tracked.
/seed.*.json
!/seed.example.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Claude Code (local-only state + agent worktrees)
/.claude/

# Playwright MCP scratch — per-call page snapshots, console logs, and
# screenshots saved by the @playwright/mcp server during browser smoke
# passes. Ephemeral; useful while a stage is in flight, no value committed.
.playwright-mcp/
/m*-*.png
